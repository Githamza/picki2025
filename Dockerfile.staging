# Staging image built by Coolify (picki-staging app) from the `staging` branch.
# Two stages: Angular build with the staging configuration, then nginx serving
# the SPA with an index.html fallback so deep links survive reloads.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- --configuration staging

FROM nginx:alpine
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/my-angular-app/browser /usr/share/nginx/html
